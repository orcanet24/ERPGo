# Copia este archivo a .env y completa los valores. El .env real NO se sube al
# repositorio: lleva los secretos de esta instalación.

APP_NAME=ERPGo
APP_ENV=development
APP_URL=http://localhost:8080
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
GRPC_PORT=9095

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=erpgo
DB_SQLITE_PATH=data/empresas/default.sqlite3

# Llave maestra del ERP: cifra las credenciales de cada empresa. Una propia por
# instalación, en hexadecimal (64 caracteres). Cambiarla inutiliza las
# credenciales ya cifradas.
JWT_SECRET=

# Respan: pasarela alojada por la que salen las llamadas de IA de los informes
# (trazabilidad de cada petición). Vacía = el ERP habla directo con el proveedor
# de siempre, como hasta ahora. La clave se crea en
# https://platform.respan.ai/platform/gateway/api-keys y es un secreto del
# servidor: nunca se guarda en la base ni se muestra en pantalla.
RESPAN_API_KEY=
# Solo para Respan Enterprise, que sirve la pasarela en su propio dominio. Vacía
# = https://api.respan.ai/api
RESPAN_BASE_URL=

# Exa: búsqueda web para los informes y agentes (scripts/buscar_web_exa.py).
# Vacía = la búsqueda web queda apagada y el ERP sigue igual. La clave se crea en
# https://dashboard.exa.ai y es un secreto del servidor: nunca se guarda en la
# base ni se muestra en pantalla.
EXA_API_KEY=
