%% graph.mmd — Grafo de dependencias de ERPGo (paquetes internos)
%% Generado el 19/10/2026 a partir de los import "erpgow/…" reales del código.
%% Ver también: indice.html (pestaña "Grafo de conexiones")
%%
%% Renderizar en: https://mermaid.live  (o con el plugin de VS Code)
%%
%% Leyenda por color:
%%   azul      → puntos de entrada / configuración
%%   verde     → lógica de negocio (internal/)
%%   amarillo  → capa HTTP / presentación (interfaces/)
%%   violeta   → persistencia (infrastructure/)
%%   naranja   → contrato externo (proto/)

flowchart LR

  %% ── Puntos de entrada ─────────────────────────────────
  subgraph ENTRY["Puntos de entrada"]
    direction TB
    CMD_SERVER["cmd/server<br/>(erpgow.exe)"]
    CMD_SEMILLAR["cmd/semillar"]
    TOOLS_E["tools/estress"]
    TOOLS_L["tools/limpiar"]
  end

  %% ── Configuración ─────────────────────────────────────
  CONFIGS["configs<br/>(.env)"]

  %% ── Lógica de negocio ─────────────────────────────────
  subgraph BIZ["Lógica de negocio (internal/)"]
    direction TB
    I_LOGGER["internal/logger"]
    I_SERVICE["internal/service<br/>(servicio Windows)"]
    I_SETUP["internal/setup<br/>(wizard)"]
    I_POS["internal/pos<br/>(gRPC POS)"]
    I_ORCH["internal/orchestrator<br/>(escrituras)"]
    I_QUEUE["internal/queue"]
    I_SEC["internal/security"]
    I_UPLOAD["internal/upload"]
  end

  %% ── Capa HTTP ─────────────────────────────────────────
  WEB["interfaces/web<br/>(~170 handlers HTTP)"]

  %% ── Persistencia y contrato ───────────────────────────
  PERSIST["infrastructure/persistence<br/>(MySQL / MariaDB)"]
  PROTO["proto/pos<br/>(gRPC generado)"]

  %% ── Aristas (25 dependencias reales) ──────────────────
  CMD_SERVER --> CONFIGS
  CMD_SERVER --> PERSIST
  CMD_SERVER --> WEB
  CMD_SERVER --> I_LOGGER
  CMD_SERVER --> I_POS
  CMD_SERVER --> I_SERVICE
  CMD_SERVER --> I_SETUP

  CMD_SEMILLAR --> CONFIGS
  CMD_SEMILLAR --> PERSIST
  CMD_SEMILLAR --> WEB

  WEB --> CONFIGS
  WEB --> PERSIST
  WEB --> I_ORCH
  WEB --> I_POS
  WEB --> I_QUEUE
  WEB --> I_SEC
  WEB --> I_UPLOAD

  I_ORCH --> PERSIST
  I_POS --> PERSIST
  I_POS --> PROTO
  I_QUEUE --> PERSIST
  I_SETUP --> PERSIST

  TOOLS_E --> PERSIST
  TOOLS_E --> I_ORCH
  TOOLS_L --> PERSIST

  %% ── Estilos ───────────────────────────────────────────
  classDef entry fill:#1f6feb33,stroke:#58a6ff,stroke-width:2px,color:#e6edf3
  classDef biz   fill:#23863633,stroke:#7ee787,stroke-width:2px,color:#e6edf3
  classDef http  fill:#9e6a0333,stroke:#e3b341,stroke-width:2px,color:#e6edf3
  classDef data  fill:#8957e533,stroke:#bc8cff,stroke-width:2px,color:#e6edf3
  classDef proto fill:#da363333,stroke:#ffa657,stroke-width:2px,color:#e6edf3

  class CMD_SERVER,CMD_SEMILLAR,TOOLS_E,TOOLS_L,CONFIGS entry
  class I_LOGGER,I_SERVICE,I_SETUP,I_POS,I_ORCH,I_QUEUE,I_SEC,I_UPLOAD biz
  class WEB http
  class PERSIST data
  class PROTO proto
