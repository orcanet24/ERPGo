/erpgow
/server
.external/
__pycache__/

# Secretos y estado local: jamás al repositorio
.env
.dev.vars
config/empresas/
backup/
logs/

# Binario Windows: se compila con build.bat y nunca se sube a GitHub
/bin/

# Documentacion historica del ERP PHP original (~38 MB): se conserva en disco pero no en el repositorio
/doc/*
!/doc/informe-auditoria-tecnica-2026-10-29.md
!/doc/seguimiento-auditoria-tecnica-2026-10-29.md

server.exe

# Binario del ERP compilado localmente (build.bat): nunca al repositorio
erpgo.exe
erpgo.exe~

# Binario de addons compilados para pruebas locales
addons/*/erp-addon-*.exe

# Carpetas de ejecucion en vivo: logs, bases de la prueba e2e y capturas de pantalla
.e2e/
screenshots/
data/escrituras/
*.rar
*.zip

# Runtime del asistente de desarrollo (Freebuff): 28k archivos de caché de
# módulos Go, cookies de sesión local y logs. NO son del producto: jamás al
# repositorio (la auditoría 2026-11-22 encontró cookies.txt y el caché
# completo rastreados).
.freebuff/

# Artefactos de pruebas y auditorías locales
_audit_*
*.bak
